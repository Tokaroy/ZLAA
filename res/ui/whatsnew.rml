<rml>
<head>
    <title>What's New</title>
    <link type="text/rcss" href="theme.rcss" />
    <link type="text/rcss" href="window.rcss" />
</head>
<body>
    <!-- Shown once after an update (ui.cpp: open_whats_new). Rewrite the notes for every release. -->
    <window id="window" class="small news">
        <heading class="window-title"><icon class="news" />What's New</heading>
        <p id="news-version" class="hint" />
        <news-list>
            <news-item><dot />Touch controls have been added, with options to resize, move, and change the opacity of the buttons. Either a d-pad or joystick can be displayed.</news-item>
            <news-item><dot />Button remapping for controllers.</news-item>
            <news-item><dot />ZLAA Builder: build the game on a Windows or Linux PC.</news-item>
            <news-item><dot />Performance and stutter enhancements.</news-item>
        </news-list>
        <menu-list>
            <button id="news-ok">OK</button>
            <button id="news-notes">Full Release Notes</button>
        </menu-list>
    </window>
</body>
</rml>
